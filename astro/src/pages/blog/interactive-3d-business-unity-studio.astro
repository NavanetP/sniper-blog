  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: "https://sniperindia.com" },
    { "@type": "ListItem", position: 2, name: "Blog", item: "https://blog.sniperindia.com" },
    { "@type": "ListItem", position: 3, name: "How Businesses Are Using Interactive 3D Experiences with Unity Studio", item: CANONICAL },
  ],
