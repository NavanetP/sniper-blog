---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Page Not Found | Sniper Systems"
  description="The page you're looking for doesn't exist."
  canonicalUrl="https://blog.sniperindia.com/404"
>
  <div class="min-h-[60vh] flex flex-col items-center justify-center text-center px-4">
    <p class="text-8xl font-bold text-gray-100 select-none">404</p>
    <h1 class="text-2xl font-semibold text-gray-900 mt-4 mb-2">Page not found</h1>
    <p class="text-gray-500 mb-8 max-w-sm">
      The page you're looking for doesn't exist or has been moved.
    </p>
    <a
      href="/"
      class="inline-flex items-center gap-2 px-6 py-3 bg-gray-900 text-white text-sm font-semibold rounded-lg hover:bg-gray-700 transition-colors"
    >
      ← Back to Blog
    </a>
  </div>
</BaseLayout>
