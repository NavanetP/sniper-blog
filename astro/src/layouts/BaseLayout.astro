---
/**
 * BaseLayout.astro
 *
 * Mirrors the React <Layout> component (Navbar + main + Footer) but
 * adds proper static <head> meta, Open Graph tags, and canonical URLs
 * — all rendered at build time so crawlers see them immediately.
 *
 * Usage:
 *   ---
 *   import BaseLayout from "../layouts/BaseLayout.astro";
 *   ---
 *   <BaseLayout title="Page Title" description="…" ogImage="…">
 *     <!-- page content / React islands -->
 *   </BaseLayout>
 */

import "../styles/global.css";
import { Navbar } from "@/components/Navbar";
import { Footer } from "@/components/Footer";

export interface Props {
  /** <title> tag content */
  title: string;
  /** Meta description */
  description: string;
  /** Keywords for meta[name=keywords] (optional) */
  keywords?: string;
  /** Open Graph / Twitter card image URL */
  ogImage?: string;
  /** Canonical URL — defaults to current page URL */
  canonicalUrl?: string;
  /** og:type — defaults to "website" */
  ogType?: "website" | "article";
  /** Article published date (ISO string, used when ogType="article") */
  publishedTime?: string;
  /** Article author name */
  author?: string;
}

const {
  title,
  description,
  keywords,
  ogImage = "https://i.ibb.co/9BNf5rZ/sniper-logo-neww.png",
  canonicalUrl = Astro.url.href,
  ogType = "website",
  publishedTime,
  author,
} = Astro.props;

const siteName = "Sniper B2B Solutions";
const ogTitle  = title.includes(siteName) ? title : `${title} | ${siteName}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary meta -->
    <title>{title}</title>
    <meta name="description" content={description} />
    {keywords && <meta name="keywords" content={keywords} />}
    {author  && <meta name="author"   content={author} />}

    <!-- Canonical -->
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph -->
    <meta property="og:type"        content={ogType} />
    <meta property="og:site_name"   content={siteName} />
    <meta property="og:title"       content={ogTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url"         content={canonicalUrl} />
    <meta property="og:image"       content={ogImage} />
    {ogType === "article" && publishedTime && (
      <meta property="article:published_time" content={publishedTime} />
    )}
    {ogType === "article" && author && (
      <meta property="article:author" content={author} />
    )}

    <!-- Twitter Card -->
    <meta name="twitter:card"        content="summary_large_image" />
    <meta name="twitter:title"       content={ogTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image"       content={ogImage} />

    <!-- Favicon -->
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />

    <!-- Google Fonts (same as Navbar) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500;600;700&family=Sora:wght@400;500;600;700&family=Inter:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>

  <body class="min-h-screen flex flex-col bg-background text-foreground antialiased">
    <!--
      Navbar is a React island with client:load so the interactive
      mega-menu and mobile drawer work in the browser.
    -->
    <Navbar client:load />

    <main class="flex-1">
      <slot />
    </main>

    <Footer client:load />
  </body>
</html>
